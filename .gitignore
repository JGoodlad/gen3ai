# Dependencies
node_modules/
deps/venv/
.env

# Python
__pycache__/
*.py[cod]
*$py.class

# Packaging leftovers from `pip install -e .` / a wheel build. The editable install itself
# lands OUTSIDE the tree (a .pth in site-packages), which is why it left nothing to ignore
# until someone builds without --no-build-isolation and gets a stray egg-info.
*.egg-info/
build/

# OS
.DS_Store
Thumbs.db

# Models
models/*
!models/goldens/
*.zip

# Logs
tensorboard/
.claude/worktrees/

# Replays
replays/

# Per-month Smogon stats cache — large (~3.5MB/month), regenerable by
# running tools/smogon_stats_downloader/sync.py. The aggregated merged file
# at data/pokemon/gen3_smogon_stats.json IS tracked.
data/pokemon/smogon_stats_monthly/

# Scratch space — research scripts and probe outputs, always UNTRACKED (the main checkout
# carries ~280 of them). A script a doc cites as a GATE graduates into the tree instead
# (src/rust_sim/harness/ holds the node-vs-rust parity gates that used to live here).
tmp/
