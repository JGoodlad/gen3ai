+    def _remember_challenge(self, message):
+        """Record a `/challenge` PM addressed to us so that it is not LOST.
+
+        Unpatched, a challenge PM that arrives while this client is inside a battle (or inside
+        `leave_battle`, which drains and DISCARDS until |deinit) is handed to the battle parser,
+        which ignores it. The server sends it exactly once, so the challenge is gone and the next
+        `accept_challenge` blocks forever. poke-env's `send_challenges` PIPELINES — it releases on
+        battle START (player.py:363) and sends the next `/challenge` immediately — so every game
+        after the first lands in exactly that window. Measured 2026-09-16: the ours_challenge half
+        of a `main.anchors --opponent foulplay` cell died at game 2, three times out of three.
+        """
+        split_msg = message.split("|")
+        if (
+            len(split_msg) == 9
+            and split_msg[1] == "pm"
+            and split_msg[3].strip().replace("!", "").replace("\u203d", "") == self.username
+            and split_msg[4].startswith("/challenge")
+        ):
+            if not hasattr(self, "_pending_challenges"):
+                self._pending_challenges = []
+            challenger = split_msg[2].strip()
+            if split_msg[5]:
+                self._pending_challenges.append((split_msg[5], challenger))
+            else:
+                # an empty format field is a CANCELLED / consumed challenge
+                self._pending_challenges = [
+                    c for c in self._pending_challenges if c[1] != challenger
+                ]
+
     async def receive_message(self):
         message = await self.websocket.recv()
         logger.debug("Received message from websocket: {}".format(message))
+        self._remember_challenge(message)
         return message
 
     async def send_message(self, room, message_list):
