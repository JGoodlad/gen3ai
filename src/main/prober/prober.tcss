/* Prober-specific layout. Loaded after the shared theme.tcss (see app.py
 * CSS_PATH). The three-region body: trace browser | invocation list | analysis. */

#body {
    height: 1fr;
}

/* sidebar & middle are fixed-width but drag-resizable via the PaneSplitter bars
 * between them; #analysis is 1fr so it absorbs the slack. */
#sidebar {
    width: 36;
}

#middle {
    width: 34;
}

#analysis {
    width: 1fr;
}

#ckpt-badge {
    height: auto;
    padding: 0 1;
    color: $text-muted;
}

#battle-header {
    height: auto;
    padding: 0 1;
    color: $accent;
    text-style: bold;
}

/* `scrollbar-gutter: stable` reserves the 1-cell scrollbar column even when no bar is shown, so
 * content doesn't shift left by a cell the moment a scrollbar appears (the "off by a pixel on scroll"
 * jump) — applied to every scrollable region. */
#trace-tree {
    height: 1fr;
    scrollbar-gutter: stable;
}

/* `y` reveals the current battle's replay path on its own line (selectable under `v` copy mode);
 * hidden until used, shown via `.display = True` in the handler. */
#replay-path-bar {
    height: auto;
    width: 1fr;
    padding: 0 1;
    background: $surface;
    display: none;
}

#invocation-list {
    height: 1fr;
    scrollbar-gutter: stable;
}

#analysis-scroll {
    height: 1fr;
    scrollbar-gutter: stable;
}

/* Sections stack in the scroll, so tables size to their rows rather than 1fr. */
DataTable {
    height: auto;
    max-height: 24;
}

#board-field {
    height: auto;
    padding: 0 1 1 1;
}

#outcome-summary {
    height: auto;
    padding: 1 1 0 1;
}

#outcome-events {
    height: auto;
    padding: 0 1 1 1;
}

#board-summary {
    height: auto;
    padding: 1 1;
}

.board-label {
    height: auto;
    padding: 1 1 0 1;
    color: $text-muted;
    text-style: bold;
}

#board-our, #board-opp {
    height: auto;
}

/* Summary section: a context header over two side-by-side tables (moves | switches). */
#summary-head {
    height: auto;
    padding: 1 1;
}

#summary-tables, #team-tables {
    height: auto;
}

/* Content-width columns (not 1fr) so MOVES + SWITCHES sit together at the left
 * instead of splitting the pane 50/50 and pushing SWITCHES to the far right.
 * A small right margin is the only gap between them; slack collects on the right. */
.summary-col {
    width: auto;
    height: auto;
    margin-right: 3;
}

.summary-col-label {
    height: auto;
    padding: 0 1;
    color: $text-muted;
    text-style: bold;
}

#summary-moves, #summary-switches, #summary-opp {
    width: auto;
    height: auto;
}

/* Team tab: two full-detail panels that SPLIT the analysis pane 50/50. Unlike the Summary's
 * MOVES+SWITCHES (auto-width, packed left and anchored by the MOVES DataTable), both Team columns
 * are all-Static, so `width: auto` has nothing to anchor the Horizontal and collapses each column to
 * ~2 cells (every word then wraps vertically). Give the columns + their Statics a definite 1fr. */
#team-tables > .summary-col {
    width: 1fr;
}
#team-our, #team-opp {
    width: 1fr;
    height: auto;
}
